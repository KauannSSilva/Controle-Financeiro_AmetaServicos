{
  "name": "controle-financeiro-ameta",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres mailpit",
    "db:down": "docker compose down",
    "db:migrate": "npm -w api run db:migrate",
    "db:status": "npm -w api run db:status",
    "import:planilha": "npm -w api run import:planilha --",
    "api:chaves": "npm -w api run chaves",
    "seed:admin": "npm -w api run seed:admin --",
    "api": "npm -w api run dev",
    "site": "npm -w web run dev",
    "typecheck": "npm -w api run typecheck && npm -w web run typecheck",
    "test": "npm -w api test",
    "db:studio": "npm -w api run db:studio",
    "site:build": "npm -w web run build"
  },
  "engines": {
    "node": ">=22"
  }
}

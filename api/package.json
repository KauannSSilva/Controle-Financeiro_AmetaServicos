{
  "name": "@ameta/api",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:status": "dotenv -e ../.env -- prisma migrate status",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "import:planilha": "tsx --env-file=../.env scripts/importar-planilha.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:studio": "dotenv -e ../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "exceljs": "4.4.0",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

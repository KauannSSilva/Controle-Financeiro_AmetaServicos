# Copie para .env e troque a senha. O .env nunca vai para o Git.
POSTGRES_DB=ameta
POSTGRES_USER=ameta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Mesma senha e porta de cima
DATABASE_URL="postgresql://ameta:troque-esta-senha@localhost:5432/ameta?schema=public"

# Opcional. Os testes usam um banco separado; sem esta linha usam o mesmo servidor com o banco "ameta_teste".
# DATABASE_URL_TESTE="postgresql://ameta:troque-esta-senha@localhost:5432/ameta_teste?schema=public"

# ---- API (Fase 2) ----
# As três chaves abaixo são geradas por: npm run api:chaves
# JWT_SEGREDO=
# CHAVE_CRIPTOGRAFIA=
# CHAVE_HMAC=

# Porta da API e endereço do front (Fase 3)
API_PORTA=3000
ORIGEM_FRONT=http://localhost:5173
NODE_ENV=development

# ---- E-mail dos convites ----
# No seu computador, o Mailpit (npm run db:up) recebe os e-mails: abra http://localhost:8025.
# Para enviar de verdade, troque pelo SMTP da empresa (ex.: Microsoft 365: smtp.office365.com, porta 587).
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_SENHA=
EMAIL_REMETENTE="Controle Financeiro Ameta <nao-responda@ameta.com.br>"
# Endereço do site no link do convite (padrão: ORIGEM_FRONT)
# URL_SITE=http://localhost:5173
